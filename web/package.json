{
  "name": "lix-web",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "COPILOTKIT_TELEMETRY_DISABLED=true NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "COPILOTKIT_TELEMETRY_DISABLED=true NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "COPILOTKIT_TELEMETRY_DISABLED=true NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "json2ts --input ../contracts/schemas.json --output lib/contracts.gen.ts --unreachableDefinitions --additionalProperties false",
    "e2e": "playwright test",
    "predev": "node scripts/gen-tokens.mjs && node scripts/copy-maplibre-worker.mjs && node scripts/copy-docs.mjs",
    "prebuild": "node scripts/gen-tokens.mjs && node scripts/copy-maplibre-worker.mjs && node scripts/copy-docs.mjs",
    "tokens": "node scripts/gen-tokens.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/react-core": "1.77.1",
    "@copilotkit/react-ui": "1.77.1",
    "@copilotkit/runtime": "1.77.1",
    "hyparquet": "1.31.2",
    "maplibre-gl": "6.13.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "json-schema-to-typescript": "16.0.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
