          "type": "boolean"
        },
        "stale_reason": {
          "default": "none",
          "description": "A newer edition is published, or the download is older than the source's publishing cadence allows",
          "enum": [
            "newer_edition",
            "older_than_cadence",
            "none"
          ],
          "title": "Stale Reason",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The upstream version the build used",
          "title": "Version"
        }
      },
      "required": [
        "id",
        "title",
        "licence",
        "attribution"
      ],
      "title": "SourceRef",
      "type": "object"
    },
