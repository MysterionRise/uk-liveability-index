        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First day of the period (ISO date)",
          "title": "Start"
        }
      },
      "required": [
        "label"
      ],
      "title": "SourcePeriod",
      "type": "object"
    },
