            "$ref": "#/$defs/ThemeScore"
          },
          "title": "Themes",
          "type": "array"
        },
        "urban_rural": {
          "title": "Urban Rural",
          "type": "string"
        },
        "weaknesses": {
          "items": {
            "$ref": "#/$defs/IndicatorValue"
          },
          "title": "Weaknesses",
          "type": "array"
        }
      },
      "required": [
        "lsoa21cd",
        "lsoa_name",
        "msoa21cd",
        "local_authority",
        "region",
        "nation",
        "nation_name",
        "urban_rural",
        "population",
        "overall",
        "overall_percentile",
        "coverage",
        "preset",
        "themes",
        "strengths",
        "weaknesses",
        "key_facts",
        "centre",
        "bbox"
      ],
      "title": "AreaProfile",
      "type": "object"
    },
