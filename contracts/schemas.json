    "SourcePeriod": {
      "description": "The period a source's data describes (not when it was downloaded).",
      "properties": {
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last day of the period (ISO date)",
          "title": "End"
        },
        "kind": {
          "default": "text",
          "description": "How to print the dates; 'text' means show the label",
          "enum": [
            "year",
            "month",
            "day",
            "range",
            "text"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "description": "English wording, e.g. 'September 2023 to August 2026'",
          "title": "Label",
          "type": "string"
