# Data (every layer is rebuilt by the pipeline; `lix` creates the directories)
/data/
outputs/
# Data packs (make data-pack)
dist/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Environment (keys): .env, .env.local, web/.env.production…, but the template
.env*
!.env.example
*.pem

# DuckDB
*.duckdb
*.duckdb.wal

# Tools
.ruff_cache/

# Turn logs written when the demo dataset is served (LIX_DATA_DIR=fixtures/demo)
fixtures/demo/logs/
data-ie/

# The scripted model's eval run is a smoke test, not a report
docs/evals/test.json

# Test passes: each release's briefs, findings and evidence stay on the machine that ran
# them (qa/README.md is the brief every tester starts from)
qa/*
!qa/README.md
